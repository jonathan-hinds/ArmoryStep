# Normalize source and Unity YAML so commits are stable across operating systems.
* text=auto
/.gitattributes       text eol=lf
/.gitignore           text eol=lf

*.cs                 text eol=lf
*.asmdef             text eol=lf
*.asmref             text eol=lf
*.json               text eol=lf
*.inputactions       text eol=lf
*.shader             text eol=lf
*.shadergraph        text eol=lf
*.shadersubgraph     text eol=lf
*.compute            text eol=lf
*.cginc              text eol=lf
*.hlsl               text eol=lf
*.glsl               text eol=lf
*.uss                text eol=lf
*.uxml               text eol=lf
*.md                 text eol=lf
*.txt                text eol=lf
*.xml                text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf

# Unity text-serialized assets. Keep these diffable and recoverable in Git.
*.meta               text eol=lf
*.unity              text eol=lf
*.prefab             text eol=lf
*.asset              text eol=lf
*.mat                text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.playable           text eol=lf
*.mask               text eol=lf
*.physicMaterial     text eol=lf
*.physicsMaterial2D  text eol=lf
*.scenetemplate      text eol=lf

# Large/non-mergeable assets live in Git LFS. LFS preserves every committed
# revision while keeping the main Git database usable as the game grows.
*.psd          filter=lfs diff=lfs merge=lfs -text
*.psb          filter=lfs diff=lfs merge=lfs -text
*.kra          filter=lfs diff=lfs merge=lfs -text
*.clip         filter=lfs diff=lfs merge=lfs -text
*.tif          filter=lfs diff=lfs merge=lfs -text
*.tiff         filter=lfs diff=lfs merge=lfs -text
*.exr          filter=lfs diff=lfs merge=lfs -text
